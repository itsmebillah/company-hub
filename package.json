{
  "name": "company-hub",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "doctor": "node --conditions=react-server --import tsx scripts/doctor.ts",
    "setup:local": "node --conditions=react-server --import tsx scripts/setup-local.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/public-routes.spec.ts --project=chromium --grep \"PWA assets|notification tracking\"",
    "test:e2e:public": "playwright test tests/e2e/public-routes.spec.ts --project=chromium",
    "test:e2e:authenticated": "playwright test tests/e2e/authenticated-flows.spec.ts --project=chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:unit": "node --conditions=react-server --import tsx --test tests/unit/**/*.test.ts",
    "authorize:google-drive": "node --conditions=react-server --import tsx scripts/authorize-google-drive.ts",
    "preflight:google-drive-authorization": "node --conditions=react-server --import tsx scripts/authorize-google-drive.ts --preflight",
    "audit:google-drive-authorization": "node --conditions=react-server --import tsx scripts/verify-google-drive-app-authorization.ts",
    "verify:google": "node --conditions=react-server --import tsx scripts/verify-google-integrations.ts",
    "configure:google-sheets": "node --conditions=react-server --import tsx scripts/configure-google-sheets-reporting.ts",
    "process:google-sheets": "node --conditions=react-server --import tsx scripts/process-google-sheets-sync.ts",
    "verify:google-sheets": "node --conditions=react-server --import tsx scripts/run-google-sheets-verification.ts",
    "process:attendance-media": "node --conditions=react-server --import tsx scripts/process-attendance-media.ts",
    "verify:attendance-media": "node --conditions=react-server --import tsx scripts/verify-attendance-media.ts",
    "verify:brave": "node scripts/verify-brave.mjs",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^11.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "supabase": "^2.109.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vercel": "^56.3.2"
  }
}
