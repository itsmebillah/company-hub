NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_URL=postgresql://postgres:your-database-password@your-database-host:5432/postgres
CRON_SECRET=generate-a-random-secret
GOOGLE_SERVICE_ACCOUNT_EMAIL=company-hub@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-with-service-account-private-key\\n-----END PRIVATE KEY-----\\n"
# Local development may use an absolute path outside the repository instead of
# the two inline credential variables above. Never configure this path in Vercel.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=C:\\secure-path\\company-hub-service-account.json
# Local-only OAuth client file. Use inline secret variables in production.
GOOGLE_DRIVE_OAUTH_CLIENT_FILE=C:\\secure-path\\company-hub-drive-oauth-client.json
GOOGLE_DRIVE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_DRIVE_SELFIES_FOLDER_ID=your-google-drive-folder-id
GOOGLE_DRIVE_PICKER_API_KEY=your-google-picker-browser-api-key
GOOGLE_DRIVE_PICKER_APP_ID=your-google-cloud-project-number
GOOGLE_SHEETS_REPORTING_SPREADSHEET_ID=your-google-sheets-spreadsheet-id
GOOGLE_SHEETS_REPORTING_COMPANY_ID=00000000-0000-0000-0000-000000000000
